    <layout_stack
     border_size="0"
     follows="all"
     height="442"
     layout="topleft"
     left="0"
     name="panes"
     orientation="horizontal"
     top="56"
     width="900">
        <layout_panel
         height="442"
         auto_resize="false"
         layout="topleft"
         min_width="140"
         name="sidebar_panel"
         width="220">
            <scroll_container
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="sidebar_scroll"
             overlay_scrollbars="true"
             reserve_scroll_corner="false"
             top="0"
             width="220">
                <sk_inventory_sidebar
                 follows="left|top|right"
                 height="442"
                 layout="topleft"
                 left="0"
                 name="sidebar"
                 top="0"
                 width="220">
                    <text
                     follows="left|top"
                     font="SansSerifSmallBold"
                     height="18"
                     layout="topleft"
                     left="8"
                     name="heading_favorites"
                     text_color="LtGray_50"
                     top="0"
                     width="190">FAVORITES</text>
                    <text
                     follows="left|top"
                     height="32"
                     layout="topleft"
                     left="12"
                     name="favorites_hint"
                     text_color="LtGray_50"
                     top_pad="0"
                     width="186"
                     word_wrap="true">Drag folders here, or star a search</text>
                    <sk_inventory_favorites_panel
                     allow_multi_select="false"
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="0"
                     name="panel_favorites"
                     section="favorites"
                     top_pad="0"
                     width="205">
                        <scroll
                         follows="all"
                         hide_scrollbar="true"
                         name="favorites_frame"
                         reserve_scroll_corner="false" />
                    </sk_inventory_favorites_panel>
                    <sk_saved_search_rows
                     follows="left|top"
                     height="0"
                     layout="topleft"
                     left="0"
                     name="saved_searches"
                     top_pad="0"
                     width="205" />
                    <text
                     follows="left|top"
                     font="SansSerifSmallBold"
                     height="18"
                     layout="topleft"
                     left="8"
                     name="heading_inventory"
                     text_color="LtGray_50"
                     top_pad="0"
                     width="190">INVENTORY</text>
                    <sk_inventory_sidebar_panel
                     allow_multi_select="false"
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="0"
                     name="panel_inventory"
                     section="inventory"
                     top_pad="0"
                     width="205">
                        <scroll
                         follows="all"
                         hide_scrollbar="true"
                         name="inventory_frame"
                         reserve_scroll_corner="false" />
                    </sk_inventory_sidebar_panel>
                    <text
                     follows="left|top"
                     font="SansSerifSmallBold"
                     height="18"
                     layout="topleft"
                     left="8"
                     name="heading_marketplace"
                     text_color="LtGray_50"
                     top_pad="0"
                     width="190">MARKETPLACE</text>
                    <sk_inventory_sidebar_panel
                     allow_multi_select="false"
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="0"
                     name="panel_marketplace"
                     section="marketplace"
                     top_pad="0"
                     width="205">
                        <scroll
                         follows="all"
                         hide_scrollbar="true"
                         name="marketplace_frame"
                         reserve_scroll_corner="false" />
                    </sk_inventory_sidebar_panel>
                    <text
                     follows="left|top"
                     font="SansSerifSmallBold"
                     height="18"
                     layout="topleft"
                     left="8"
                     name="heading_library"
                     text_color="LtGray_50"
                     top_pad="0"
                     width="190">LIBRARY</text>
                    <sk_inventory_sidebar_panel
                     allow_multi_select="false"
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="0"
                     name="panel_library"
                     section="library"
                     top_pad="0"
                     width="205">
                        <scroll
                         follows="all"
                         hide_scrollbar="true"
                         name="library_frame"
                         reserve_scroll_corner="false" />
                    </sk_inventory_sidebar_panel>
                </sk_inventory_sidebar>
            </scroll_container>
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="false"
         layout="topleft"
         name="sidebar_edge_panel"
         width="6">
            <sk_pane_edge
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="sidebar_edge"
             pane="sidebar"
             tool_tip="Drag to resize; double-click for the default"
             top="0"
             width="6" />
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="true"
         layout="topleft"
         min_width="200"
         name="content_panel"
         width="418">
            <sk_inventory_list
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="list_view"
             tab_stop="true"
             top="0"
             width="418" />
            <sk_inventory_icons
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="icons_view"
             tab_stop="true"
             top="0"
             visible="false"
             width="418" />
            <sk_inventory_columns
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="columns_view"
             tab_stop="true"
             top="0"
             visible="false"
             width="418" />
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="false"
         layout="topleft"
         name="details_edge_panel"
         width="6">
            <sk_pane_edge
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="details_edge"
             pane="details"
             tool_tip="Drag to resize; double-click for the default"
             top="0"
             width="6" />
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="false"
         layout="topleft"
         min_width="140"
         name="details_panel"
         width="250">
            <text
             follows="all"
             height="426"
             layout="topleft"
             left="8"
             name="details_text"
             right="-8"
             text_color="LtGray_50"
             top="8"
             word_wrap="true" />
        </layout_panel>
    </layout_stack>
    <text
     follows="left|bottom|right"
     height="16"
     layout="topleft"
     left="8"
     name="status_text"
     right="-170"
     top="501"
     use_ellipses="true" />
    <slider
     can_edit_text="false"
     label="size"
     label_width="26"
     show_text="false"
     decimal_digits="0"
     follows="right|bottom"
     height="16"
     increment="1"
     initial_value="96"
     layout="topleft"
     max_val="180"
     min_val="64"
     name="size_slider"
     right="-8"
     tool_tip="Double-click for the default size"
     top="501"
     visible="false"
     width="152" />
</floater>
