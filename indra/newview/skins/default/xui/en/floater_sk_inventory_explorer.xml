    <sk_explorer_tab_strip
     follows="left|top|right"
     height="26"
     layout="topleft"
     left="0"
     name="tab_strip"
     right="-1"
     top="0" />
    <button
     follows="top|left"
     height="22"
     image_overlay="Single_Folder_Back"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     layout="topleft"
     left="4"
     name="back_btn"
     tool_tip="Back"
     top="29"
     width="24" />
    <button
     follows="top|left"
     height="22"
     image_overlay="Single_Folder_Forward"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     layout="topleft"
     left_pad="2"
     name="forward_btn"
     tool_tip="Forward"
     top="29"
     width="24" />
    <button
     follows="top|left"
     height="22"
     image_overlay="Single_Folder_Up"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
