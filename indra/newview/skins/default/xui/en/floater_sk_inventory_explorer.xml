    <string name="no_selection">No item selected</string>
    <string name="menu_menu_title">[COUNT] ITEMS</string>
    <string name="menu_full_perm_only">(Full perm only)</string>
    <string name="menu_tip_cut">Cut  (Ctrl+X)</string>
    <string name="menu_tip_copy">Copy  (Ctrl+C)</string>
    <string name="menu_tip_paste">Paste  (Ctrl+V)</string>
    <string name="menu_tip_favorite">Add to Favorites</string>
    <string name="menu_tip_unfavorite">Remove from Favorites</string>
    <string name="menu_tip_delete">Delete  (Del)</string>
    <string name="group_folders">Folders</string>
    <string name="group_objects">Objects</string>
    <string name="group_clothing">Clothing</string>
    <string name="group_bodyparts">Body Parts</string>
    <string name="group_textures">Textures</string>
    <string name="group_sounds">Sounds</string>
    <string name="group_animations">Animations</string>
    <string name="group_gestures">Gestures</string>
    <string name="group_landmarks">Landmarks</string>
    <string name="group_notecards">Notecards</string>
    <string name="group_scripts">Scripts</string>
    <string name="group_materials">Materials</string>
    <string name="group_settings">Settings</string>
    <string name="group_callingcards">Calling Cards</string>
    <string name="group_other">Other</string>
    <string name="group_today">Today</string>
    <string name="group_yesterday">Yesterday</string>
    <string name="group_this_week">This Week</string>
    <string name="group_this_month">This Month</string>
    <string name="group_earlier_this_year">Earlier This Year</string>
    <string name="group_unknown">Unknown</string>
    <string name="group_system_folders">System Folders</string>
    <string name="group_no_brand">No Brand</string>
    <string name="group_full_perm">Full Perm</string>
    <string name="group_copy_modify">Copy &amp; Modify</string>
    <string name="group_copy_transfer">Copy &amp; Transfer</string>
    <string name="group_copy_only">Copy Only</string>
    <string name="group_no_copy">No Copy</string>
    <string name="group_worn">Worn</string>
    <string name="group_not_worn">Not Worn</string>
    <string name="group_you">You</string>
    <string name="group_by_none">None</string>
    <string name="group_by_type">Type</string>
    <string name="group_by_date">Date Acquired</string>
    <string name="group_by_brand">Brand</string>
    <string name="group_by_perms">Permissions</string>
    <string name="group_by_worn">Worn</string>
    <string name="group_by_creator">Creator</string>
    <string name="col_folder">Folder</string>
    <string name="show_all">Show all [TOTAL] (showing [SHOWN])</string>
    <string name="sort_label">Sort: [KEY] [DIR]</string>
    <string name="sort_up">&#8593;</string>
    <string name="sort_down">&#8595;</string>
    <string name="group_label">Group: [GROUP]</string>
    <sk_explorer_tab_strip
     follows="left|top|right"
     height="26"
     layout="topleft"
     left="0"
     name="tab_strip"
     right="-40"
     top="0" />
    <button
     follows="top|left"
     height="22"
     image_overlay="Single_Folder_Back"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     layout="topleft"
     left="4"
     name="back_btn"
     tool_tip="Back"
     top="29"
     width="24" />
    <button
     follows="top|left"
     height="22"
     image_overlay="Single_Folder_Forward"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     layout="topleft"
     left_pad="2"
     name="forward_btn"
     tool_tip="Forward"
     top="29"
     width="24" />
    <button
     follows="top|left"
     height="22"
     image_overlay="Single_Folder_Up"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     layout="topleft"
     left_pad="2"
     name="up_btn"
     tool_tip="Up (Backspace)"
     top="29"
     width="24" />
    <text
     follows="left|top|right"
     height="16"
     layout="topleft"
     left_pad="8"
     name="path_text"
     right="-332"
     top="33"
     use_ellipses="true" />
    <button
     follows="top|right"
     height="22"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     is_toggle="true"
     label="Group: None"
     layout="topleft"
     name="group_btn"
     right="-238"
     tool_tip="Group by"
     top="29"
     width="90" />
    <button
     follows="top|right"
     height="22"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     label="Sort: Acquired"
     layout="topleft"
     name="sort_btn"
     right="-134"
     tool_tip="Sort by"
     top="29"
     width="100" />
    <button
     follows="top|right"
     height="22"
     image_overlay="Hierarchy_View_On"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     is_toggle="true"
     layout="topleft"
     name="view_columns_btn"
     right="-106"
     tool_tip="Columns (Ctrl+1)"
     top="29"
     width="24" />
    <button
     follows="top|right"
     height="22"
     image_overlay="Thumbnail_Fallback"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     is_toggle="true"
     layout="topleft"
     name="view_icons_btn"
     right="-82"
     tool_tip="Icons (Ctrl+2)"
     top="29"
     width="24" />
    <button
     follows="top|right"
     height="22"
     image_overlay="List_View_On"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     is_toggle="true"
     layout="topleft"
     name="view_list_btn"
     right="-58"
     tool_tip="List (Ctrl+3)"
     top="29"
     width="24" />
    <button
     follows="top|right"
     height="22"
     image_overlay="Icon_Snapshot"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     is_toggle="true"
     layout="topleft"
     name="view_gallery_btn"
     right="-34"
     tool_tip="Gallery (Ctrl+4)"
     top="29"
     width="24" />
    <button
     follows="top|right"
     height="22"
     image_overlay="Info_Small"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     is_toggle="true"
     layout="topleft"
     name="details_btn"
     right="-4"
     tool_tip="Details pane"
     top="29"
     width="24" />
    <layout_stack
     border_size="0"
     follows="all"
     height="442"
     layout="topleft"
     left="0"
     name="panes"
     orientation="horizontal"
     top="56"
     width="900">
        <layout_panel
         height="442"
         auto_resize="false"
         layout="topleft"
         min_width="140"
         name="sidebar_panel"
         width="220">
            <scroll_container
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="sidebar_scroll"
             reserve_scroll_corner="false"
             top="0"
             width="220">
                <sk_inventory_sidebar
                 follows="left|top|right"
                 height="442"
                 layout="topleft"
                 left="0"
                 name="sidebar"
                 top="0"
                 width="205">
                    <text
                     follows="left|top"
                     font="SansSerifSmallBold"
                     height="18"
                     layout="topleft"
                     left="8"
                     name="heading_favorites"
                     text_color="LtGray_50"
                     top="0"
                     width="190">FAVORITES</text>
                    <text
                     follows="left|top"
                     height="32"
                     layout="topleft"
                     left="12"
                     name="favorites_hint"
                     text_color="LtGray_50"
                     top_pad="0"
                     width="186"
                     word_wrap="true">Drag folders here, or star a search</text>
                    <sk_inventory_favorites_panel
                     allow_multi_select="false"
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="0"
                     name="panel_favorites"
                     section="favorites"
                     top_pad="0"
                     width="205">
                        <scroll
                         follows="all"
                         hide_scrollbar="true"
                         name="favorites_frame"
                         reserve_scroll_corner="false" />
                    </sk_inventory_favorites_panel>
                    <text
                     follows="left|top"
                     font="SansSerifSmallBold"
                     height="18"
                     layout="topleft"
                     left="8"
                     name="heading_inventory"
                     text_color="LtGray_50"
                     top_pad="0"
                     width="190">INVENTORY</text>
                    <sk_inventory_sidebar_panel
                     allow_multi_select="false"
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="0"
                     name="panel_inventory"
                     section="inventory"
                     top_pad="0"
                     width="205">
                        <scroll
                         follows="all"
                         hide_scrollbar="true"
                         name="inventory_frame"
                         reserve_scroll_corner="false" />
                    </sk_inventory_sidebar_panel>
                    <text
                     follows="left|top"
                     font="SansSerifSmallBold"
                     height="18"
                     layout="topleft"
                     left="8"
                     name="heading_marketplace"
                     text_color="LtGray_50"
                     top_pad="0"
                     width="190">MARKETPLACE</text>
                    <sk_inventory_sidebar_panel
                     allow_multi_select="false"
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="0"
                     name="panel_marketplace"
                     section="marketplace"
                     top_pad="0"
                     width="205">
                        <scroll
                         follows="all"
                         hide_scrollbar="true"
                         name="marketplace_frame"
                         reserve_scroll_corner="false" />
                    </sk_inventory_sidebar_panel>
                    <text
                     follows="left|top"
                     font="SansSerifSmallBold"
                     height="18"
                     layout="topleft"
                     left="8"
                     name="heading_library"
                     text_color="LtGray_50"
                     top_pad="0"
                     width="190">LIBRARY</text>
                    <sk_inventory_sidebar_panel
                     allow_multi_select="false"
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="0"
                     name="panel_library"
                     section="library"
                     top_pad="0"
                     width="205">
                        <scroll
                         follows="all"
                         hide_scrollbar="true"
                         name="library_frame"
                         reserve_scroll_corner="false" />
                    </sk_inventory_sidebar_panel>
                </sk_inventory_sidebar>
            </scroll_container>
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="false"
         layout="topleft"
         name="sidebar_edge_panel"
         width="6">
            <sk_pane_edge
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="sidebar_edge"
             pane="sidebar"
             tool_tip="Drag to resize; double-click for the default"
             top="0"
             width="6" />
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="true"
         layout="topleft"
         min_width="200"
         name="content_panel"
         width="418">
            <sk_inventory_list
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="list_view"
             tab_stop="true"
             top="0"
             width="418" />
            <sk_inventory_icons
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="icons_view"
             tab_stop="true"
             top="0"
             visible="false"
             width="418" />
            <sk_inventory_columns
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="columns_view"
             tab_stop="true"
             top="0"
             visible="false"
             width="418" />
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="false"
         layout="topleft"
         name="details_edge_panel"
         width="6">
            <sk_pane_edge
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="details_edge"
             pane="details"
             tool_tip="Drag to resize; double-click for the default"
             top="0"
             width="6" />
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="false"
         layout="topleft"
         min_width="140"
         name="details_panel"
         width="250">
            <text
             follows="all"
             height="426"
             layout="topleft"
             left="8"
             name="details_text"
             right="-8"
             text_color="LtGray_50"
             top="8"
             word_wrap="true" />
        </layout_panel>
    </layout_stack>
    <text
     follows="left|bottom|right"
     height="16"
     layout="topleft"
     left="8"
     name="status_text"
     right="-170"
     top="501"
     use_ellipses="true" />
    <slider
     can_edit_text="false"
     label="size"
     label_width="26"
     show_text="false"
     decimal_digits="0"
     follows="right|bottom"
     height="16"
     increment="1"
     initial_value="96"
     layout="topleft"
     max_val="180"
     min_val="64"
     name="size_slider"
     right="-8"
     tool_tip="Double-click for the default size"
     top="501"
     visible="false"
     width="152" />
</floater>
