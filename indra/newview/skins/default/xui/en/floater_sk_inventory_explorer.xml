         height="442"
         auto_resize="false"
         layout="topleft"
         min_width="140"
         name="sidebar_panel"
         width="226">
            <sk_inventory_tree
             follows="all"
             height="442"
             layout="topleft"
             left="0"
             name="sidebar"
             tab_stop="true"
             top="0"
             width="220" />
            <inventory_panel
             follows="all"
             height="10"
             layout="topleft"
             left="0"
             name="bridge_panel"
             preinitialize_views="false"
             top="0"
             visible="false"
             width="10" />
            <!-- The edge sits inside the sidebar's panel: a panel of its own would take the stack's resize, not the content. -->
            <sk_pane_edge
             follows="top|bottom|right"
             height="442"
             layout="topleft"
             left="220"
             name="sidebar_edge"
             pane="sidebar"
             tool_tip="Drag to resize; double-click for the default"
             top="0"
             width="6" />
        </layout_panel>
        <layout_panel
         height="442"
         auto_resize="true"
         layout="topleft"
         min_width="200"
         name="content_panel"
         width="418">
