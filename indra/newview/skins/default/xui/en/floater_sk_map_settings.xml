<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 can_resize="true"
 height="470"
 layout="topleft"
 min_height="470"
 min_width="320"
 name="sk_map_settings"
 save_rect="true"
 single_instance="true"
 title="Minimap Settings"
 width="340">
    <tab_container
     follows="all"
     height="436"
     layout="topleft"
     left="4"
     name="sk_map_settings_tabs"
     right="-4"
     tab_max_width="80"
     tab_min_width="40"
     tab_position="top"
     top="30">
        <panel
         follows="all"
         height="412"
         label="View"
         layout="topleft"
         left="0"
         name="sk_tab_view"
         top="0"
         width="332">
            <text
             follows="left|top"
             height="16"
             layout="topleft"
             left="8"
             name="sk_view_mode_label"
             top="10"
             width="105">
                View
            </text>
            <combo_box
             control_name="SKMapViewMode"
             follows="left|top"
             height="23"
             layout="topleft"
             left_pad="5"
             name="sk_view_mode"
             top_delta="-4"
             width="198">
                <combo_box.item
                 label="Follow, turning with the camera"
                 name="sk_view_mode_follow"
                 value="0" />
                <combo_box.item
                 label="Region, north up"
                 name="sk_view_mode_region"
                 value="1" />
            </combo_box>
            <slider
             control_name="SKMapRegionMargin"
             decimal_digits="2"
             follows="left|top|right"
             height="16"
             increment="0.01"
             label="Region margin"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="1"
             min_val="0.05"
             name="sk_region_margin"
             text_width="40"
             tool_tip="How much of the neighbouring regions shows around the region, as a fraction of its width"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapZoomMeters"
             decimal_digits="0"
             follows="left|top|right"
             height="16"
             increment="1"
             label="Zoom (m)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="2048"
             min_val="4"
             name="sk_zoom_meters"
             text_width="40"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapAutoCenter"
             follows="left|top"
             height="16"
             label="Ease back after a pan"
             layout="topleft"
             left="8"
             name="sk_auto_center"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapCompassRing"
             follows="left|top"
             height="16"
             label="Compass ring"
             layout="topleft"
             left="8"
             name="sk_compass_ring"
             top_pad="5"
             width="308" />
        </panel>
        <panel
         follows="all"
         height="412"
         label="Layers"
         layout="topleft"
         left="0"
         name="sk_tab_layers"
         top="0"
         width="332">
            <check_box
             control_name="SKMapLayerFloorplan"
             follows="left|top"
             height="16"
             label="Floorplan"
             layout="topleft"
             left="8"
             name="sk_layer_floorplan"
             tool_tip="The captured map of buildings and land under the mini-map"
             top="8"
             width="308" />
            <check_box
             control_name="SKMapLayerStairs"
             follows="left|top"
             height="16"
             label="Stairs and ramps"
             layout="topleft"
             left="8"
             name="sk_layer_stairs"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerDoors"
             follows="left|top"
             height="16"
             label="Doors"
             layout="topleft"
             left="8"
             name="sk_layer_doors"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerLadders"
             follows="left|top"
             height="16"
             label="Ladders"
             layout="topleft"
             left="8"
             name="sk_layer_ladders"
             tool_tip="Ladders in their own colour"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerElevators"
             follows="left|top"
             height="16"
             label="Elevators"
             layout="topleft"
             left="8"
             name="sk_layer_elevators"
             tool_tip="Elevator cars outlined where they are now"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerContours"
             follows="left|top"
             height="16"
             label="Contours"
             layout="topleft"
             left="8"
             name="sk_layer_contours"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerParcels"
             follows="left|top"
             height="16"
             label="Parcel lines"
             layout="topleft"
             left="8"
             name="sk_layer_parcels"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerParcelsForSale"
             follows="left|top"
             height="16"
             label="Parcels for sale"
             layout="topleft"
             left="8"
             name="sk_layer_parcels_for_sale"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerParcelsCollision"
             follows="left|top"
             height="16"
             label="Parcels you may not enter"
             layout="topleft"
             left="8"
             name="sk_layer_parcels_collision"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerVehicles"
             follows="left|top"
             height="16"
             label="Vehicles"
             layout="topleft"
             left="8"
             name="sk_layer_vehicles"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapVehicleGrow"
             decimal_digits="1"
             follows="left|top|right"
             height="16"
             increment="0.5"
             label="Zoomed-out size (x)"
             label_width="110"
             layout="topleft"
             left="24"
             max_val="6"
             min_val="1"
             name="sk_vehicle_grow_max"
             text_width="40"
             top_pad="5"
             width="292" />
            <check_box
             control_name="SKMapLayerFiringLines"
             follows="left|top"
             height="16"
             label="Firing lines"
             layout="topleft"
             left="8"
             name="sk_layer_firing_lines"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerProjectiles"
             follows="left|top"
             height="16"
             label="Projectiles"
             layout="topleft"
             left="8"
             name="sk_layer_projectiles"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapLayerChatRings"
             follows="left|top"
             height="16"
             label="Chat rings"
             layout="topleft"
             left="8"
             name="sk_layer_chat_rings"
             top_pad="5"
             width="308" />
        </panel>
        <panel
         follows="all"
         height="412"
         label="People"
         layout="topleft"
         left="0"
         name="sk_tab_people"
         top="0"
         width="332">
            <check_box
             control_name="SKMapAvatarColors"
             follows="left|top"
             height="16"
             label="Contact and group colours"
             layout="topleft"
             left="8"
             name="sk_avatar_colors"
             top="8"
             width="308" />
            <check_box
             control_name="SKMapHeadingTriangles"
             follows="left|top"
             height="16"
             label="Heading triangles"
             layout="topleft"
             left="8"
             name="sk_heading_triangles"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapFloorChevrons"
             follows="left|top"
             height="16"
             label="Floor above or below"
             layout="topleft"
             left="8"
             name="sk_floor_chevrons"
             top_pad="5"
             width="308" />
        </panel>
        <panel
         follows="all"
         height="412"
         label="Combat"
         layout="topleft"
         left="0"
         name="sk_tab_combat"
         top="0"
         width="332">
            <check_box
             control_name="SKMapAllyProbeUntitled"
             follows="left|top"
             height="16"
             label="Ask about untitled avatars"
             layout="topleft"
             left="8"
             name="sk_ally_probe_untitled"
             top="8"
             width="308" />
            <check_box
             control_name="SKMapMarkerLabels"
             follows="left|top"
             height="16"
             label="Ally codes on dots and tags"
             layout="topleft"
             left="8"
             name="sk_marker_labels"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapMarkerFontPx"
             decimal_digits="0"
             follows="left|top|right"
             height="16"
             increment="1"
             label="Code size (px)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="11"
             min_val="8"
             name="sk_marker_font_px"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapMarkerPaddingPx"
             decimal_digits="2"
             follows="left|top|right"
             height="16"
             increment="0.25"
             label="Code padding (px)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="3"
             min_val="0"
             name="sk_marker_padding_px"
             text_width="40"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapPing"
             follows="left|top"
             height="16"
             label="Ping in the menu"
             layout="topleft"
             left="8"
             name="sk_ping"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapKillLineSeconds"
             decimal_digits="1"
             follows="left|top|right"
             height="16"
             increment="0.1"
             label="Event line (s)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="5"
             min_val="0.1"
             name="sk_kill_line_seconds"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapDeathIconSeconds"
             decimal_digits="1"
             follows="left|top|right"
             height="16"
             increment="0.5"
             label="Death mark (s)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="10"
             min_val="0.5"
             name="sk_death_icon_seconds"
             text_width="40"
             top_pad="5"
             width="308" />
        </panel>
        <panel
         follows="all"
         height="412"
         label="Automap"
         layout="topleft"
         left="0"
         name="sk_tab_automap"
         top="0"
         width="332">
            <check_box
             control_name="SKMapMLEnable"
             follows="left|top"
             height="16"
             label="Show automap in mouselook"
             layout="topleft"
             left="8"
             name="sk_ml_enable"
             tool_tip="The mini-map drawn faintly over the world while in mouselook"
             top="8"
             width="308" />
            <check_box
             control_name="SKMapMLFloorplan"
             enabled_control="SKMapMLEnable"
             follows="left|top"
             height="16"
             label="Floorplan"
             layout="topleft"
             left="8"
             name="sk_ml_floorplan"
             tool_tip="Off leaves only people, vehicles and projectiles"
             top_pad="5"
             width="308" />
            <slider
             enabled_control="SKMapMLEnable"
             control_name="SKMapMLSize"
             decimal_digits="2"
             follows="left|top|right"
             height="16"
             increment="0.05"
             label="Size"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="1.2"
             min_val="0.3"
             name="sk_ml_size"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             enabled_control="SKMapMLEnable"
             control_name="SKMapMLSurfaceOpacity"
             decimal_digits="2"
             follows="left|top|right"
             height="16"
             increment="0.01"
             label="Surface opacity"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="0.5"
             min_val="0.02"
             name="sk_ml_surface"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             enabled_control="SKMapMLEnable"
             control_name="SKMapMLCentreFade"
             decimal_digits="2"
             follows="left|top|right"
             height="16"
             increment="0.01"
             label="Centre fade"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="0.4"
             min_val="0.1"
             name="sk_ml_centre_fade"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             enabled_control="SKMapMLEnable"
             control_name="SKMapMLSelfFadePx"
             decimal_digits="0"
             follows="left|top|right"
             height="16"
             increment="2"
             label="Self fade (px)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="32"
             min_val="8"
             name="sk_ml_self_fade"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             enabled_control="SKMapMLEnable"
             control_name="SKMapMLOuterFade"
             decimal_digits="2"
             follows="left|top|right"
             height="16"
             increment="0.01"
             label="Outer fade"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="0.75"
             min_val="0.25"
             name="sk_ml_outer_fade"
             text_width="40"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapMLRotate"
             enabled_control="SKMapMLEnable"
             follows="left|top"
             height="16"
             label="Rotate with camera (off: north up)"
             layout="topleft"
             left="8"
             name="sk_ml_rotate"
             top_pad="8"
             width="308" />
        </panel>
        <panel
         follows="all"
         height="412"
         label="Advanced"
         layout="topleft"
         left="0"
         name="sk_tab_advanced"
         top="0"
         width="332">
            <check_box
             control_name="SKMapDebugReadout"
             follows="left|top"
             height="16"
             label="Show timings and counts"
             layout="topleft"
             left="8"
             name="sk_debug_readout"
             top="8"
             width="308" />
            <check_box
             control_name="SKMapDebugForceCombat"
             follows="left|top"
             height="16"
             label="Force combat mode (debug)"
             layout="topleft"
             left="8"
             name="sk_debug_force_combat"
             top_pad="5"
             width="308" />
            <check_box
             control_name="SKMapRecord"
             follows="left|top"
             height="16"
             label="Record map updates (to the logs folder)"
             layout="topleft"
             left="8"
             name="sk_map_record"
             tool_tip="Records why the map and the navmesh under it update, until unticked."
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapHoverEnterPx"
             decimal_digits="0"
             follows="left|top|right"
             height="16"
             increment="1"
             label="Name shows (px)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="30"
             min_val="4"
             name="sk_hover_enter_px"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapHoverExitPx"
             decimal_digits="0"
             follows="left|top|right"
             height="16"
             increment="1"
             label="Name hides (px)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="40"
             min_val="4"
             name="sk_hover_exit_px"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapNametagMaxWidth"
             decimal_digits="0"
             follows="left|top|right"
             height="16"
             increment="10"
             label="Tag width (px)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="400"
             min_val="100"
             name="sk_nametag_max_width"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapAllyProbeRate"
             decimal_digits="1"
             follows="left|top|right"
             height="16"
             increment="0.5"
             label="Probes a second"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="10"
             min_val="0.5"
             name="sk_ally_probe_rate"
             text_width="40"
             top_pad="5"
             width="308" />
            <slider
             control_name="SKMapMarkerCodeHold"
             decimal_digits="0"
             follows="left|top|right"
             height="16"
             increment="10"
             label="Code hold (s)"
             label_width="110"
             layout="topleft"
             left="8"
             max_val="600"
             min_val="0"
             name="sk_marker_code_hold"
             text_width="40"
             top_pad="5"
             width="308" />
        </panel>
    </tab_container>
</floater>
