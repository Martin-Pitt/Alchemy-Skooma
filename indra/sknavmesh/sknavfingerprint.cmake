# -*- cmake -*-
#
# Hashes the navmesh library's own sources into a header, so a tile product
# cached by one build is never taken for another's: any change to how a tile
# is built changes the key it is stored under. Run as a build step, so it
# follows every edit rather than only a reconfigure.
#
# In: SOURCE_DIR, OUTPUT.

file(GLOB sources LIST_DIRECTORIES false "${SOURCE_DIR}/*.cpp" "${SOURCE_DIR}/*.h")
list(SORT sources)
set(all "")
foreach(source IN LISTS sources)
  file(READ "${source}" text)
  # Line endings differ by checkout, not by build.
  string(REPLACE "\r" "" text "${text}")
  string(SHA256 digest "${text}")
  string(APPEND all "${digest}")
endforeach()
string(SHA256 all "${all}")
string(SUBSTRING "${all}" 0 16 short)
set(text "// Generated by sknavfingerprint.cmake.\n#define SKNAV_BUILD_FINGERPRINT 0x${short}ull\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUTPUT}" "${text}")
endif()
