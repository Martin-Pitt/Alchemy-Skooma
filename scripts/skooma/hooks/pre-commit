#!/bin/sh
# Skooma: keep commits on the right branch and fork-only files out of upstream-bound
# feature branches.  Installed to .git/hooks by `git skooma bootstrap`.

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0

case "$branch" in
develop | publish)
    cat >&2 <<MSG

  Refused: '$branch' does not take commits.

  Work happens in a worktree:  git skooma new <name>
  Then land it:                git skooma integrate <name>

MSG
    exit 1
    ;;
main)
    # The integration branch takes glue and setup commits.  Feature work does not
    # belong here — use a worktree so it stays upstreamable.
    exit 0
    ;;
local)
    # A docs commit here is copied onto main by the post-commit hook, so it must hold docs alone.
    # A merge (local taking main or a private branch) is not one.
    [ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0
    staged=$(git diff --cached --name-only)
    if printf '%s\n' "$staged" | grep -q '^doc/skooma/' && printf '%s\n' "$staged" | grep -qv '^doc/skooma/'; then
        cat >&2 <<MSG

  Refused: a commit on local that changes doc/skooma must change nothing else,
  so that it can go to main whole (the post-commit hook copies it there).
  Commit the docs on their own.

MSG
        exit 1
    fi
    exit 0
    ;;
esac

# Working branches (feature-, fix-, workaround-, amend-, foundation-, any custom class) are upstream pull
# requests in waiting: no fork-only files.  Classes live in skooma.class.
class=$(git config --get "branch.$branch.skooma" 2>/dev/null)
if [ -z "$class" ]; then
    for c in feature fix workaround amend foundation $(git config --get-all skooma.class 2>/dev/null); do
        case "$branch" in "$c"-*) class=$c ; break ;; esac
    done
fi
case "$class" in '' | glue | sidecar | private | spike) exit 0 ;; esac

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

bad=$(printf '%s\n' "$staged" | grep -E '^(AGENTS\.md|CLAUDE\.local\.md|doc/skooma/|scripts/skooma/|\.githooks/|\.worktrees/|\.claude/|\.vcpkg-shared/|vs2026-os/|ninja-os/|build-(Windows|Darwin|Linux)-)' || true)
if [ -n "$bad" ]; then
    cat >&2 <<MSG

  Refused: fork-only files staged on upstream-bound branch '$branch':

$(printf '%s\n' "$bad" | sed 's/^/    /')

  These belong on glue (or a skooma-<name> sidecar), not in a feature that
  will be sent upstream.  Unstage them:  git restore --staged <path>

MSG
    exit 1
fi

exit 0
